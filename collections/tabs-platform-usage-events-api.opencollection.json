{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tabs Platform Catalog Usage Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List usage events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tabsplatform.com/usage-events"
          },
          "docs": "List usage events"
        },
        {
          "info": {
            "name": "Create a usage event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tabsplatform.com/usage-events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a usage event"
        },
        {
          "info": {
            "name": "Delete a usage event",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tabsplatform.com/usage-events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a usage event"
        }
      ]
    }
  ],
  "bundled": true
}