{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tabs Platform Catalog API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tabsplatform.com/items"
          },
          "docs": "List items - products/services mapped to GL accounting codes."
        },
        {
          "info": {
            "name": "List revenue categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tabsplatform.com/categories"
          },
          "docs": "List revenue categories"
        }
      ]
    }
  ],
  "bundled": true
}